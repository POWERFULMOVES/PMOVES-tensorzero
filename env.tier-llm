# PMOVES.AI Tier Environment: LLM
# For LLM Gateway and AI services (TensorZero, etc.)
# Source after env.shared: source env.shared && source env.tier-llm.sh

# ============================================================================
# LLM Tier Configuration
# ============================================================================

TIER=llm

# Request limits
MAX_CONCURRENT_REQUESTS=${MAX_CONCURRENT_REQUESTS:-50}
MAX_REQUEST_SIZE_MB=${MAX_REQUEST_SIZE_MB:-10}
REQUEST_TIMEOUT_MS=${REQUEST_TIMEOUT_MS:-120000}  # 2 minutes
STREAMING_TIMEOUT_MS=${STREAMING_TIMEOUT_MS:-300000}  # 5 minutes

# Token limits
MAX_TOKENS_PER_REQUEST=${MAX_TOKENS_PER_REQUEST:-128000}
MAX_OUTPUT_TOKENS=${MAX_OUTPUT_TOKENS:-8192}
CONTEXT_WINDOW_SIZE=${CONTEXT_WINDOW_SIZE:-200000}

# Rate limiting (per model)
RATE_LIMIT_ENABLED=${RATE_LIMIT_ENABLED:-true}
RATE_LIMIT_REQUESTS_PER_MINUTE=${RATE_LIMIT_REQUESTS_PER_MINUTE:-100}
RATE_LIMIT_TOKENS_PER_MINUTE=${RATE_LIMIT_TOKENS_PER_MINUTE:-100000}

# Observability
OBSERVABILITY_ENABLED=${OBSERVABILITY_ENABLED:-true}
REQUEST_LOGGING_ENABLED=${REQUEST_LOGGING_ENABLED:-true}
METRICS_EXPORT_ENABLED=${METRICS_EXPORT_ENABLED:-true}

# ClickHouse for metrics
CLICKHOUSE_URL=${CLICKHOUSE_URL:-http://tensorzero-clickhouse:8123}
CLICKHOUSE_USER=${CLICKHOUSE_USER:?CLICKHOUSE_USER must be set}
CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD:?CLICKHOUSE_PASSWORD must be set}
CLICKHOUSE_DATABASE=${CLICKHOUSE_DATABASE:-tensorzero}

# Model configuration
DEFAULT_MODEL=${DEFAULT_MODEL:-claude-sonnet-4-5}
DEFAULT_TEMPERATURE=${DEFAULT_TEMPERATURE:-0.7}
DEFAULT_TOP_P=${DEFAULT_TOP_P:-0.9}
DEFAULT_TOP_K=${DEFAULT_TOP_K:-40}

# Caching
CACHE_ENABLED=${CACHE_ENABLED:-true}
CACHE_TTL=${CACHE_TTL:-3600}  # 1 hour
CACHE_MAX_SIZE=${CACHE_MAX_SIZE:-10000}

# Fallback configuration
FALLBACK_ENABLED=${FALLBACK_ENABLED:-true}
FALLBACK_MODEL=${FALLBACK_MODEL:-gpt-4o-mini}
FALLBACK_MAX_RETRIES=${FALLBACK_MAX_RETRIES:-2}
